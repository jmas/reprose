{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./_frontend/*"]
    },
    "lib": ["dom", "dom.iterable", "esnext"],
    "sourceMap": true,
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true
  },
  "include": ["_frontend/**/*.ts", "_frontend/**/*.tsx"],
  "exclude": []
}
